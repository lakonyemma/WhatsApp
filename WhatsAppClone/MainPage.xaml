<Page x:Class="WhatsAppClone.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid MinWidth="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ChatAccentBrush}" Padding="16,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="WhatsApp" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Header="Dark mode" Foreground="White"
                          Margin="0,0,22,0" Toggled="ThemeToggle_Toggled" />
            <Button Grid.Column="2" Content="Log out" Click="Logout_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Contacts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Contact" Click="AddContact_Click" />
                    </Grid>
                    <ListView x:Name="ContactsList" Grid.Row="1" SelectionChanged="ContactsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Padding="8" Spacing="10">
                                    <Ellipse Width="40" Height="40">
                                        <Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImageUrl}" Stretch="UniformToFill" /></Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ContactName" Text="Select a contact" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="TypingStatus" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                    <Button x:Name="ClearChatButton" Grid.Column="1" Content="Clear Chat" Click="ClearChat_Click"
                            VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="MessagesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesStack" Margin="18,16" />
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="12,10" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="EmojiButton" Content="Emoji" Margin="0,0,8,0">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="😊" Click="Emoji_Click" />
                                <MenuFlyoutItem Text="😂" Click="Emoji_Click" />
                                <MenuFlyoutItem Text="❤️" Click="Emoji_Click" />
                                <MenuFlyoutItem Text="👍" Click="Emoji_Click" />
                                <MenuFlyoutItem Text="🎉" Click="Emoji_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="AttachButton" Grid.Column="1" Content="Attach Media" Click="AttachMedia_Click" Margin="0,0,8,0" />
                    <TextBox x:Name="MessageInput" Grid.Column="2" PlaceholderText="Type a message"
                             KeyDown="MessageInput_KeyDown" Margin="0,0,8,0" />
                    <Button x:Name="SendButton" Grid.Column="3" Content="Send" Click="SendButton_Click"
                            Background="{StaticResource ChatAccentBrush}" Foreground="White" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
