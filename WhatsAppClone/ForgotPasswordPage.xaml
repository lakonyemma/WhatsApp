<Page x:Class="WhatsAppClone.ForgotPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <Grid MinHeight="600">
            <StackPanel Width="380" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="Forgot password" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Enter the email address used to register." TextWrapping="Wrap" Margin="0,0,0,22" />
                <TextBox x:Name="EmailInput" Header="Email address" InputScope="EmailSmtpAddress" Margin="0,0,0,18" />
                <Button x:Name="SendCodeButton" Content="Send Recovery Code" Click="SendCodeButton_Click"
                        Background="{StaticResource ChatAccentBrush}" Foreground="White" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="CodeOutput" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,8" />
                <TextBlock x:Name="CooldownOutput" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#FFC62828" />
                <Button Content="Back to login" Click="Back_Click" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
